{
  "name": "musictutor-studio",
  "description": "Desktop lesson production studio for piano educators",
  "author": "Amanorsac Studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc -b && vite build",
    "build:windows": "npm run build && electron-builder --win nsis",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b --force"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "jsdom": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest",
    "@spotify/basic-pitch": "1.0.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "studio.amanorsac.musictutor",
    "productName": "MusicTutor",
    "directories": {
      "output": "installer"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/onnxruntime-node/bin/**/linux/**"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MusicTutor-Setup-${version}.${ext}",
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!**/*.map",
        "!node_modules/onnxruntime-node/bin/**/linux/**",
        "!node_modules/onnxruntime-node/bin/**/darwin/**",
        "!node_modules/onnxruntime-node/bin/**/win32/arm64/**"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MusicTutor"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**"
    ],
    "mac": {
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!**/*.map",
        "!node_modules/onnxruntime-node/bin/**/linux/**",
        "!node_modules/onnxruntime-node/bin/**/win32/**"
      ]
    },
    "fileAssociations": [
      {
        "ext": "musictutor-lesson",
        "name": "MusicTutor lesson",
        "description": "A lesson shared from MusicTutor: a recording and the MIDI played during it",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "1.22.0"
  }
}
