{
  "name": "musictutor-studio",
  "description": "Lesson studio for music teachers: record and stream tutorials, and learn songs by ear",
  "author": "Amanorsac Studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "tsc -b && vite build",
    "build:windows": "npm run build && electron-builder --win nsis",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc -b --force"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "jsdom": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wait-on": "latest",
    "@spotify/basic-pitch": "1.0.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "studio.amanorsac.musictutor",
    "productName": "MusicTutor",
    "directories": {
      "output": "installer",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/onnxruntime-node/bin/**/linux/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-Windows.${ext}",
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!**/*.map",
        "!node_modules/onnxruntime-node/bin/**/linux/**",
        "!node_modules/onnxruntime-node/bin/**/darwin/**",
        "!node_modules/onnxruntime-node/bin/**/win32/arm64/**"
      ],
      "icon": "build/icon.ico",
      "extraFiles": [
        {
          "from": "build/README.txt",
          "to": "README.txt"
        },
        {
          "from": "THIRD_PARTY_NOTICES.txt",
          "to": "THIRD_PARTY_NOTICES.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MusicTutor",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "MusicTutor",
      "deleteAppDataOnUninstall": false,
      "license": "build/LICENCE.txt"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/onnxruntime-common/**"
    ],
    "mac": {
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!**/*.map",
        "!node_modules/onnxruntime-node/bin/**/linux/**",
        "!node_modules/onnxruntime-node/bin/**/win32/**",
        "!node_modules/onnxruntime-node/bin/**/darwin/x64/**"
      ],
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "artifactName": "${productName}-${version}-macOS.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MusicTutor records your microphone and instruments into your lessons.",
        "NSCameraUsageDescription": "MusicTutor shows your cameras in the lessons you record and stream."
      },
      "extraResources": [
        {
          "from": "THIRD_PARTY_NOTICES.txt",
          "to": "THIRD_PARTY_NOTICES.txt"
        }
      ]
    },
    "fileAssociations": [
      {
        "ext": "musictutor-lesson",
        "name": "MusicTutor lesson",
        "description": "A lesson shared from MusicTutor: a recording and the MIDI played during it",
        "role": "Editor"
      }
    ],
    "copyright": "Copyright © 2026 Amanorsac Studio",
    "icon": "build/icon.png",
    "dmg": {
      "title": "${productName} ${version}",
      "sign": true,
      "contents": [
        {
          "x": 130,
          "y": 170,
          "type": "file"
        },
        {
          "x": 410,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 270,
          "y": 330,
          "type": "file",
          "path": "build/README.txt",
          "name": "Read Me First.txt"
        }
      ]
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "1.22.0"
  }
}
